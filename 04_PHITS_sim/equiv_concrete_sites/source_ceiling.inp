$ 天井上方の水平面から垂直降下する宇宙線中性子（e-type=25）
$ main 側で c11=線源面半幅, c7=線源高さ [cm] を定義してから infl: する
$ 遮蔽スラブは c1=部屋半幅で一様。線源面は検出器付近 c11×c11 cm
$ z+ = 上方向、dir=-1 で -z へ垂直入射
 <source> = 1.0
   s-type =    2
       x0 =  -c11
       x1 =   c11
       y0 =  -c11
       y1 =   c11
       z0 =    c7
       z1 =    c7
      dir =   -1.0
   e-type =   25
    icenv =    5
 solarmod = 100.0
     alti =   0.03
     glat =  36.15
    glong = 140.08
