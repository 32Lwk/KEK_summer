[title]
He-3 detector with SUS304 wall and thermal neutron source

[parameters]
 icntl = 0
maxcas = 10000
maxbch = 1
 e-mode = 1
emin(15) = 1e-3
emin(16) = 1e-3
emin(17) = 1e-3
emin(18) = 1e-3
emin(19) = 1e-3
 itall = 1
igamma = 1
  negs = 2

set: c1[15.0]   $ d: source-to-SUS surface distance [cm]

[source]
s-type = 2
  proj = neutron
    e0 = 2.5e-8
    x0 = -2.54
    x1 =  2.54
    y0 = -39.53/2
    y1 =  39.53/2
    z0 = -2.74-c1
    z1 = -2.74-c1
   dir = 1.0

[material]
mat[1] 3He 1.0
mat[2] Fe 70 Cr 18 Ni 9 Mn 2 Si 1

[surface]
1 rcc 0 -39.53/2 0  0 39.53 0  2.54
2 rcc 0 -39.93/2 0  0 39.93 0  2.74
3 so 100

[cell]
1  1  -0.00124   -1
2  2  -8.0        1 -2
3  0              2 -3
4 -1              3

[t-track]
  part = neutron proton triton
  mesh = xyz
x-type = 1
    nx = 1
 -2.5  2.5
y-type = 2
    ny = 100
  ymin = -2.5
  ymax =  2.5
z-type = 2
    nz = 100
  zmin = -2.5
  zmax =  2.5
e-type = 1
    ne = 1
   0 1e10
  axis = yz
  file = tracks.out
 gshow = 1
epsout = 1

[t-4dtrack]
file = 4dt.out
historymax = 100

[t-deposit]
  mesh = reg
   reg = 1
output = deposit
e-type = 2
    ne = 75
  emin = 0
  emax = 1.5
  file = de.out
  axis = eng
  unit = 3
epsout = 1
 dresol = 0.05

[t-deposit]
  mesh = reg
   reg = 1
output = deposit
e-type = 2
    ne = 75
  emin = 0.191
  emax = 0.850
  file = de2.out
  axis = eng
  unit = 3
epsout = 1
 dresol = 0.05

[end]
