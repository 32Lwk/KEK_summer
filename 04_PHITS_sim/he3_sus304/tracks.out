set: c3[   1.460727E-07] c4[   1.036067E-02]
p: cmin[c3] cmax[c4]
p: dmin(1e-31)
p: zlog
p: xmin( -2.500000    ) xmax(  2.500000    )
p: ymin( -2.500000    ) ymax(  2.500000    )

