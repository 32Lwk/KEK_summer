#           2.81250E-02  2.85000E-02  2.88750E-02  2.92500E-02  2.96250E-02
#           3.00000E-02
     axis =   eng           # axis of output
     file = de2.out         # file name of output for the above axis
     part =  all      
# kf/name :  0        
   epsout =    1            # (D=0) generate eps file by ANGEL
   mother =  all            # (D=all) number of specific mother
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :          85 (  0)           0 (  0)          85 (  0)

