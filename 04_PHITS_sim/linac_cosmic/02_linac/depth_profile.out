[ T-Track ]
    title = Neutron flux vs depth, column above tunnel
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -250.0000      # minimum value of x-mesh points
     xmax =   250.0000      # maximum value of x-mesh points
#    xdel =   500.0000      # mesh width of x-mesh points
       nx =      1          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -2.50000E+02  2.50000E+02
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -300.0000      # minimum value of y-mesh points
     ymax =   300.0000      # maximum value of y-mesh points
#    ydel =   600.0000      # mesh width of y-mesh points
       ny =      1          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -3.00000E+02  3.00000E+02
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =  -1000.000      # minimum value of z-mesh points
     zmax =   600.0000      # maximum value of z-mesh points
#    zdel =   25.00000      # mesh width of z-mesh points
       nz =     64          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#          -1.00000E+03 -9.75000E+02 -9.50000E+02 -9.25000E+02 -9.00000E+02
#          -8.75000E+02 -8.50000E+02 -8.25000E+02 -8.00000E+02 -7.75000E+02
#          -7.50000E+02 -7.25000E+02 -7.00000E+02 -6.75000E+02 -6.50000E+02
#          -6.25000E+02 -6.00000E+02 -5.75000E+02 -5.50000E+02 -5.25000E+02
#          -5.00000E+02 -4.75000E+02 -4.50000E+02 -4.25000E+02 -4.00000E+02
#          -3.75000E+02 -3.50000E+02 -3.25000E+02 -3.00000E+02 -2.75000E+02
#          -2.50000E+02 -2.25000E+02 -2.00000E+02 -1.75000E+02 -1.50000E+02
#          -1.25000E+02 -1.00000E+02 -7.50000E+01 -5.00000E+01 -2.50000E+01
#           0.00000E+00  2.50000E+01  5.00000E+01  7.50000E+01  1.00000E+02
#           1.25000E+02  1.50000E+02  1.75000E+02  2.00000E+02  2.25000E+02
#           2.50000E+02  2.75000E+02  3.00000E+02  3.25000E+02  3.50000E+02
#           3.75000E+02  4.00000E+02  4.25000E+02  4.50000E+02  4.75000E+02
#           5.00000E+02  5.25000E+02  5.50000E+02  5.75000E+02  6.00000E+02
   e-type =    1            # e-mesh is given by the below data
       ne =      3          # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
            1.00000E-09  1.00000E-06  1.00000E-01  1.00000E+06
     unit =    1            # unit is [1/cm^2/source]
 material =  all            # (D=all) number of specific material
     axis =       z            # axis of output
     file = depth_profile.out  # file name of output for the above axis
     part =  neutron  
# kf/name :  2112     
   epsout =    1            # (D=0) generate eps file by ANGEL
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :          77 (  0)           0 (  0)          77 (  0)

