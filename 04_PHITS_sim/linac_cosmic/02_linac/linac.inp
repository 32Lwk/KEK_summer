  220    1 -1.205e-3  -42  51             $ トンネル室内空気
  221    1 -1.205e-3  -51                 $ トンネル検出器位置（ビーム高さ）
$ --- 大気・地層 -------------------------------------------------------------
  300    1 -1.205e-3  -52                 $ 屋外検出器位置
  310    1 -1.205e-3  -10   20  30  52    $ GL より上の大気
  400    3 -1.35      -10  -20  21  40 41 $ 関東ローム    0 〜 -3 m
  410    4 -1.65      -10  -21  22  41    $ 常総粘土     -3 〜 -5 m
  420    5 -1.85      -10  -22      41    $ 下総層群     -5 m 以深
  900    0             10 -12             $ 真空シェル（線源球 c1 はこの中。物質なし）
  999   -1             12                 $ outer void

[ Volume ]
   reg          vol
   110    7.588e+08
   111    9.600e+07
