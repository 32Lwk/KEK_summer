$ ============================================================================
$  タリー
$ ============================================================================
[ T-Track ]
$ 各測定点のスペクトル
    title = Flux spectra at measurement points [1/cm2/s]
     mesh =  reg
      reg =  111 221 300 110 220
   e-type =    3          $ log メッシュ（1e-9〜1e+6 MeV を 5 bin/decade）
       ne =   75
     emin =  1.0e-9       $ 1 neV
     emax =  1.0e+6       $ 1 TeV（ミューオンの高エネルギー側まで入れる）
     unit =    1          $ [1/cm2/source] → totfact 規格化により [/cm2/s]
     axis =  eng
     file = spectrum_reg.out
     part =  neutron photon ( muon+ muon- )
   epsout =    1

[ T-Track ]
$ 深さ方向分布
    title = Neutron flux vs depth, column above tunnel
     mesh =  xyz
   x-type =    2
       nx =    1
     xmin = -250.0
     xmax =  250.0
   y-type =    2
       ny =    1
     ymin = -300.0
     ymax =  300.0
   z-type =    2
       nz =   64
     zmin = -1000.0
     zmax =   600.0
   e-type =    1
       ne =    3
            1.0e-9  1.0e-6  1.0e-1  1.0e+6
     unit =    1
     axis =    z
     file = depth_profile.out
     part =  neutron
   epsout =    1

[ T-Track ]
$ 降り注ぐ中性子の2次元分布
    title = Cosmic-ray neutron flux, xz section
     mesh =  xyz
   x-type =    2
       nx =  120
     xmin = -1200.0
     xmax =  1200.0
   y-type =    2
       ny =    1
     ymin = -300.0
     ymax =  300.0
   z-type =    2
       nz =  110
     zmin = -1000.0
     zmax =  1200.0
   e-type =    2
       ne =    1
     emin =  1.0e-9
     emax =  1.0e+6
     unit =    1
     axis =   xz
     file = map_xz.out
     part =  neutron
    gshow =    1
   epsout =    1

[ End ]
