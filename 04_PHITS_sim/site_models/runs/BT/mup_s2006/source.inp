$ ============================================================================
$  宇宙線線源（地表・KEK つくば）  PARMA/EXPACS ベース
$  main 側で set: c1[...] と totfact を定義し、infl:{source.inp} + proj で使う
$ ----------------------------------------------------------------------------
$  s-type=9 + dir=iso : 半径 c1 の球の内側に「一様・宇宙線の角度分布どおり」の
$                       場を作る奨励設定。粒子は球の接平面上の円板から平行に
$                       入射するので、ジオメトリの内部から粒子が湧くことはない
$                       （＝球の中に全構造物を入れておくこと）。
$  icenv=5 : 地表面・ブラックホールモード。地面で反射した中性子を線源から除く。
$            大地や建屋を自分でモデル化する計算ではこれを使う（二重計上の回避）。
$  rigid は書かない : glat/glong からつくばのカットオフリジディティ（≈11 GV）が
$                     自動設定される。rigid=0.0 と書くと極域相当になり過大評価。
$ ============================================================================
 <source> = 1.0
   s-type =    9        $ 球面線源
       x0 =    0.0      $ 球中心 x [cm]
       y0 =    0.0      $ 球中心 y [cm]
       z0 =    0.0      $ 球中心 z [cm]（GL = クライストロンギャラリー床）
       r1 =    c1       $ 半径 [cm]
       r2 =    c1
      dir =   iso       $ 宇宙線線源モードの奨励設定（角度分布を自動再現）
   e-type =   25        $ 宇宙線線源（エネルギー・角度分布を絶対値込みで再現）
    icenv =    5        $ 5 = 大気圏内・地表面（ブラックホールモード）
 solarmod = 100.0       $ 太陽活動 W-index（0=極小 150=極大。2026年は下降期の目安）
     alti =   0.03      $ 高度 [km]（KEK つくば 標高 ≈ 30 m）
     glat =  36.15      $ 緯度 [deg]（KEK）
    glong = 140.08      $ 経度 [deg]（KEK）
