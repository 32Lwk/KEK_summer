'no. =  1,  ie =  1,  iy =  1'
msuc: {\huge Cosmic-ray neutron flux, xz section, deep cavity}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.36}

x: z [cm]
y: x [cm]
set: c1[ 1.091] c2[ 0.862] c5[ 0.800] c6[ 0.965] c7[ 0.061] c8[ 0.000]
