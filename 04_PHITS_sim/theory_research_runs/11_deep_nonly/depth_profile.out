[ T-Track ]
    title = Neutron flux vs depth, undisturbed soil column
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -250.0000      # minimum value of x-mesh points
     xmax =   250.0000      # maximum value of x-mesh points
#    xdel =   500.0000      # mesh width of x-mesh points
       nx =      1          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -2.50000E+02  2.50000E+02
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -300.0000      # minimum value of y-mesh points
     ymax =   300.0000      # maximum value of y-mesh points
#    ydel =   600.0000      # mesh width of y-mesh points
       ny =      1          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -3.00000E+02  3.00000E+02
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =  -1400.000      # minimum value of z-mesh points
     zmax =   600.0000      # maximum value of z-mesh points
#    zdel =   25.00000      # mesh width of z-mesh points
       nz =     80          # number of z-mesh points
