[ Title ]
linacIRON: 3D iron shield with one open face under linac tunnel
S6 proposal: soil 100 cm + concrete 200 cm + iron 150 cm overhead;
iron box (150 cm walls, +y face open) inside tunnel at beam height.
Compare to d2/D2 measurements at linacIRON (t_eq=728 cm, phi_d2=1.52e-3).

[ Parameters ]
 icntl    =        0
 maxcas   =     1500
 maxbch   =       10
 e-mode   =        2
 irqmd    =        1
 negs     =        2
 mdbatima =     3000
 maxbnk   =   100000
 iMeVperU =        1
 emin(12) =      1.0
 emin(13) =      1.0

set: c1[1600.]
set: c2[2200.]
set: c3[1500.]

[ Source ]
  totfact = -pi*c1**2
 infl:{source.inp}
     proj = neutron
 infl:{source.inp}
     proj = muon+
 infl:{source.inp}
     proj = muon-
 infl:{source.inp}
     proj = photon

