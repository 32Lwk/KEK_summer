[ Title ]
宇宙線中性子 地下実験室シミュレーション (KEK つくば)
コンクリート厚さ 250 cm の天井越し中性子フラックス測定

[ Parameters ]
 icntl   =   0
 maxcas  =   1000       $ particles per batch
 maxbch  =     10       $ number of batches (total 10000 events)
 e-mode  =    2         $ event generator mode ver.2
 irqmd   =    1         $ JQMD-2.0
 negs    =    2         $ EGS mode
 mdbatima = 3000
 maxbnk  = 100000
 iMeVperU =   1
 esmax   = 100000000.
 emin(12) = 1.0         $ electron cut-off [MeV]
 emin(13) = 1.0         $ positron cut-off [MeV]

$ ジオメトリパラメータ
set:c1[350.0]   $ 球体半径 [cm]（コンクリート + 空気室を包む）
set:c2[250.0]   $ コンクリート厚さ [cm]
set:c3[100.0]   $ 地下実験室（空気）の半径 [cm]

[ Source ]
  totfact = pi*c1**2
 infl:{source.inp}
     proj = proton
 infl:{source.inp}
     proj = 4He

[ Material ]
$ m1: 空気 (dry, sea level)  density 1.205e-3 g/cm3
m1
  N  0.7553
  O  0.2318
  Ar 0.0129

$ m2: コンクリート 2.302 g/cm3 (ANL-5800 Type 02-a)
m2
  H     -0.023
  C     -0.0023
  O     -1.22
  Na    -0.0368
  Mg    -0.005
  Al    -0.078
  Si    -0.775
  K     -0.0299
  Ca    -0.1
  Fe    -0.032

[ Surface ]
  1   so   0.001              $ center dummy sphere
  2   so   c3                 $ 地下実験室（空気球）内壁
  3   so   c3+c2              $ コンクリート外壁（= 250 cm 厚）
  4   so   c1                 $ ソース球（外側）

[ Cell ]
  10  1  -1.205e-3  -2   1   $ 地下実験室（空気）
  20  2  -2.302      2  -3   $ コンクリート天井・壁（250 cm）
  30  1  -1.205e-3   3  -4   $ コンクリート外側の大気層
  99  -1              4      $ outer void

[ T-Track ]
    title = 地下実験室 中性子フラックス (エネルギースペクトル)
     mesh =  reg
      reg =  10
   e-type =    3              $ log mesh
       ne =    80
     emin =   1.0e-9
     emax =   1.0e4
     unit =    1              $ [/cm2/source]
     axis =  eng
     file = neutron_underground.out
     part = neutron
   epsout =    1

[ T-Track ]
    title = コンクリート内 中性子フラックス (エネルギースペクトル)
     mesh =  reg
      reg =  20
   e-type =    3
       ne =    80
     emin =   1.0e-9
     emax =   1.0e4
     unit =    1
     axis =  eng
     file = neutron_concrete.out
     part = neutron
   epsout =    1

[ T-Track ]
    title = 地上大気層 中性子フラックス (参照用)
     mesh =  reg
      reg =  30
   e-type =    3
       ne =    80
     emin =   1.0e-9
     emax =   1.0e4
     unit =    1
     axis =  eng
     file = neutron_surface.out
     part = neutron
   epsout =    1

[ End ]
